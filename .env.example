# Copy to .env.local for local dev (gitignored).
# Set the same vars on Vercel: Project Settings -> Environment Variables.

# Clerk — auth. Get from clerk.com -> your app -> API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon Postgres — auto-injected by the Vercel/Neon integration.
# You don't need to copy this manually if your Neon DB is "Connect"-ed to the Vercel project.
DATABASE_URL=postgresql://...

# PromptPay receiver phone number (or 13-digit Thai ID). Used by /api/promptpay/qr
# to generate the EMVCo QR. UNSET = "0812345678" placeholder (NOT a real account).
PROMPTPAY_ID=

# Kaff's wallet address on Base mainnet (chain 8453). Used by /api/base/qr to
# generate an EIP-681 USDC transfer QR. Must be a 0x-prefixed 40-hex-char
# address — anything else (including unset) yields a "DO NOT SEND" placeholder
# QR. USDC contract on Base is hardcoded.
KAFF_BASE_WALLET=

# Resend — donation receipt emails. Sign up at resend.com, verify the kaff.me
# domain, then create an API key. Without these set, donations still record
# but no email goes out (a warning lands in Vercel logs).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kaff <hello@kaff.me>

# Safety guard for beta. Set to "false" ONLY when:
#  - PROMPTPAY_ID points to a real account YOU control or a foundation account
#  - Bank-transfer details (account number/name in BankTransfer screen) are real
#  - You're ready to accept real money in production
# Any other value (including unset) keeps the app in testing mode — a red
# "DO NOT PAY" banner appears on the QR + bank screens to protect beta testers.
VITE_KAFF_TESTING_MODE=true
